# ---------------------------------------------------------------
# MODUS — variáveis de ambiente
# Copie para .env.local. Todas são opcionais em desenvolvimento:
# sem elas o site corre com store JSON local e email desativado.
# ---------------------------------------------------------------

# URL pública (metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://modus.pt

# Área reservada (/admin)
ADMIN_PASSWORD=modus2026
ADMIN_SESSION_SECRET=gerar-uma-string-aleatoria-longa

# Supabase (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — notificação dos pedidos de orçamento
RESEND_API_KEY=
RESEND_FROM="MODUS <noreply@modus.pt>"
QUOTES_INBOX=geral@modus.pt
